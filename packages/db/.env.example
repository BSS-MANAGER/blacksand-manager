# Usado por el CLI de Prisma cuando corres comandos dentro de packages/db
# (pnpm --filter @blacksand/db migrate). La app de escritorio en tiempo de
# ejecución fija su propio DATABASE_URL apuntando a userData
# (ver apps/desktop/src/main/db-bootstrap.ts) — este archivo es solo para
# desarrollo del esquema.
DATABASE_URL="file:./dev.db"
