# BLACK SAND Manager — nombres de variables únicamente.
# NUNCA se guardan tokens/secrets reales en este archivo ni en el repositorio.
# Los valores reales (tokens, client secrets) se ingresan desde la pantalla
# "Configuración" de la app y se guardan en la bóveda de credenciales del SO
# (Windows Credential Manager vía keytar). Este archivo solo documenta
# qué variables de entorno de PROCESO existen para desarrollo local.

# --- Base de datos local ---
DATABASE_URL="file:./blacksand.db"

# --- Shopify (Custom App creada en dev.shopify.com/dashboard) ---
# Dominio de la tienda, ej: mi-tienda.myshopify.com
SHOPIFY_SHOP_DOMAIN=
# Versión de API GraphQL Admin vigente, ej: 2026-01
SHOPIFY_API_VERSION=2026-01
# Shopify retiró el token estático para apps admin-created: ahora se entrega
# un Client ID + Client Secret y la app pide un access token de 24h con
# Client Credentials Grant (packages/connectors/shopify/src/oauth.ts).
# El Client Secret NO va aquí en producción: se ingresa desde la UI y se
# guarda en la bóveda del SO. Se deja la variable solo para desarrollo local
# sin bóveda disponible (Linux/macOS de desarrollo).
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# --- Mercado Libre (OAuth2, site MLC) ---
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
# Mercado Libre rechaza "localhost" (exige una dirección pública real). No
# necesita ser un servidor tuyo: puede ser cualquier página https real (por
# defecto se usa el propio sitio de Mercado Libre) — el usuario copia el
# "code" de la URL a la que lo redirige después de autorizar y lo pega en la
# app (ver README, sección "Conectar Mercado Libre").
MELI_REDIRECT_URI=https://www.mercadolibre.cl/
MELI_SITE_ID=MLC

# --- Meta / Facebook (solo generador de feed de catálogo, Fase 6) ---
META_CATALOG_ID=
META_APP_ID=
META_APP_SECRET=

# --- Motor de sincronización ---
# Minutos entre cada sondeo (polling) de catálogo/inventario
SYNC_POLLING_INTERVAL_MINUTES=5
# Fase 3a: cada sondeo revisa pedidos creados en las últimas N horas (no se
# guarda un cursor de "último pedido visto" — la idempotencia por
# channelId+channelOrderId hace que revisar de más sea barato). El valor por
# defecto cubre dejar el PC apagado toda una noche sin perder pedidos.
ORDER_POLL_LOOKBACK_HOURS=24

# --- Modo de bóveda de credenciales ---
# "os" usa keytar/Credential Manager (recomendado, producción en Windows)
# "dev-file-insecure" usa un archivo local sin cifrar SOLO para desarrollo
# en máquinas sin soporte de keytar (nunca usar en producción)
CREDENTIAL_VAULT_MODE=os
